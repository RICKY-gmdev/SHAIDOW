<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:App"
             x:Class="App.MainPage">
    <Grid>
        <ScrollView>
            <VerticalStackLayout x:Name="PageContentLayout"
                                 Padding="30"
                                 Spacing="25">
                <Grid>
                    <Border BackgroundColor="Transparent"
                            Stroke="LightGray"
                            Padding="0"
                            HorizontalOptions="End"
                            VerticalOptions="Start">
                        <Button ImageSource="themeswitch.png"
                                HorizontalOptions="End"
                                VerticalOptions="Start"
                                WidthRequest="30"
                                HeightRequest="30"
                                BackgroundColor="Transparent"
                                Clicked="OnLightModeClicked"/>
                    </Border>
                </Grid>

                <Grid Grid.Row="1">
                    <Image Source="shaidow.png"
                           Aspect="AspectFit"
                           HeightRequest="360"
                           HorizontalOptions="Center"
                           VerticalOptions="Center"/>

                    <local:ToolAnimationView x:Name="ToolAnimationView"/>
                </Grid>

                <Border Stroke="#FF3F3D3D"
                        StrokeShape="RoundRectangle 20"
                        Padding="5"
                        BackgroundColor="Black"
                        WidthRequest="280"
                        HeightRequest="90"
                        HorizontalOptions="Center">
                    <Label Text="SHAIDOW"
                           TextColor="Cyan"
                           BackgroundColor="Black"
                           FontSize="{OnPlatform iOS=40, Android=40, MacCatalyst=40,WinUI=40}"
                           HorizontalTextAlignment="Center"
                           VerticalTextAlignment="Center"/>
                </Border>

                <ListView x:Name="ChatList"
                          ItemsSource="{Binding ChatMessages}"
                          HasUnevenRows="True"
                          BackgroundColor="Transparent"
                          SeparatorVisibility="None"
                          SelectionMode="None"
                          VerticalOptions="Fill">
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <ViewCell>
                                <Border Stroke="Black"
                                        StrokeShape="RoundRectangle 10"
                                        BackgroundColor="Black">
                                    <StackLayout Padding="10">
                                        <Label Text="{Binding Text}"
                                               IsVisible="{Binding IsText}"
                                               TextColor="White"/>
                                        <Image Source="{Binding ImageUrl}"
                                               Aspect="AspectFit"
                                               HeightRequest="256"
                                               IsVisible="{Binding IsImage}"/>
                                    </StackLayout>
                                </Border>
                            </ViewCell>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>

                <Grid x:Name="InputContainer"
                      ColumnDefinitions="*, Auto, Auto"
                      ColumnSpacing="10"
                      HorizontalOptions="Center">
                    <Entry x:Name="UserInput"
                           Grid.Column="0"
                           Placeholder="Ask SHAIDOW ..."
                           VerticalOptions="Center"
                           TextColor="cyan"
                           Completed="OnSendMessage"
                           Focused="OnUserInputFocused"
                           Unfocused="OnUserInputUnfocused"/>

                    <Button x:Name="SendButton"
                            Grid.Column="1"
                            Text="Send"
                            Clicked="OnSendMessage"
                            WidthRequest="80"
                            VerticalOptions="Center"/>

                    <ActivityIndicator x:Name="Spinner"
                                       Grid.Column="2"
                                       IsVisible="False"
                                       IsRunning="False"
                                       WidthRequest="30"
                                       HeightRequest="30"
                                       VerticalOptions="Center"
                                       Color="Cyan"/>
                </Grid>
            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>