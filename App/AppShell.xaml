<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="App.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:App"
    Shell.FlyoutBehavior="Flyout"
    Shell.BackgroundColor="#121212"
    Shell.TitleColor="#FF8814A8"
    Shell.ForegroundColor="White">

    <FlyoutItem Title="SHAIDOW" Icon="chat_icon.png">
        <ShellContent
            Title="Chat"
            ContentTemplate="{DataTemplate local:MainPage}"
            Route="MainPage" />
    </FlyoutItem>

    <FlyoutItem Title="Gallery" Icon="gallery_icon.png">
        <ShellContent
            Title="Image Gallery"
            ContentTemplate="{DataTemplate local:GalleryPage}"
            Route="GalleryPage" />
    </FlyoutItem>

</Shell>